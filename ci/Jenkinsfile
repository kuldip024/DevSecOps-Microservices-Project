pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        choice(name: 'REGISTRY', choices: ['docker.io', 'ghcr.io', 'quay.io'], description: 'Container Registry')
        string(name: 'REGISTRY_USERNAME', description: 'Registry Username')
        string(name: 'REGISTRY_PASSWORD', description: 'Registry Password (use credentials binding)')
    }

    environment {
        REGISTRY = "${params.REGISTRY}"
        REGISTRY_USERNAME = "${params.REGISTRY_USERNAME}"
        DOCKER_BUILDKIT = '1'
        GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
        BUILD_DATE = sh(script: "date -u +'%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
    }

    stages {
        stage(' Checkout') {
            steps {
                echo ' Checking out code...'
                checkout scm
                sh 'git log --oneline -1'
            }
        }

        stage(' Build Images') {
            parallel {
                stage('Build User Service') {
                    steps {
                        echo ' Building User Service image...'
                        sh '''
                            docker build \
                              --build-arg BUILD_DATE=${BUILD_DATE} \
                              --build-arg VCS_REF=${GIT_COMMIT_SHORT} \
                              -t devsecops/user-service:${GIT_COMMIT_SHORT} \
                              -t devsecops/user-service:latest \
                              services/user-service/
                        '''
                    }
                }
                stage('Build Product Service') {
                    steps {
                        echo ' Building Product Service image...'
                        sh '''
                            docker build \
                              --build-arg BUILD_DATE=${BUILD_DATE} \
                              --build-arg VCS_REF=${GIT_COMMIT_SHORT} \
                              -t devsecops/product-service:${GIT_COMMIT_SHORT} \
                              -t devsecops/product-service:latest \
                              services/product-service/
                        '''
                    }
                }
                stage('Build Frontend') {
                    steps {
                        echo ' Building Frontend image...'
                        sh '''
                            docker build \
                              --build-arg BUILD_DATE=${BUILD_DATE} \
                              --build-arg VCS_REF=${GIT_COMMIT_SHORT} \
                              -t devsecops/frontend:${GIT_COMMIT_SHORT} \
                              -t devsecops/frontend:latest \
                              frontend-ui/
                        '''
                    }
                }
            }
        }

        stage(' Security Scan') {
            steps {
                echo ' Running security scans...'
                sh '''
                    echo "Scanning for vulnerabilities..."
                    # docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                    #   aquasec/trivy image devsecops/user-service:latest
                    # docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                    #   aquasec/trivy image devsecops/product-service:latest
                    # docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                    #   aquasec/trivy image devsecops/frontend:latest
                    echo "Security scan completed"
                '''
            }
        }

        stage(' Code Quality') {
            steps {
                echo ' Running code quality checks...'
                sh '''
                    echo "Checking code quality..."
                    # SonarQube analysis can be added here
                    echo "Code quality check completed"
                '''
            }
        }

        stage('Push Images') {
            when {
                branch 'main'
            }
            steps {
                echo ' Pushing images to registry...'
                sh '''
                    echo "${REGISTRY_PASSWORD}" | docker login -u "${REGISTRY_USERNAME}" --password-stdin ${REGISTRY}
                    docker tag devsecops/user-service:latest ${REGISTRY}/devsecops/user-service:${GIT_COMMIT_SHORT}
                    docker tag devsecops/user-service:latest ${REGISTRY}/devsecops/user-service:latest
                    docker push ${REGISTRY}/devsecops/user-service:${GIT_COMMIT_SHORT}
                    docker push ${REGISTRY}/devsecops/user-service:latest

                    docker tag devsecops/product-service:latest ${REGISTRY}/devsecops/product-service:${GIT_COMMIT_SHORT}
                    docker tag devsecops/product-service:latest ${REGISTRY}/devsecops/product-service:latest
                    docker push ${REGISTRY}/devsecops/product-service:${GIT_COMMIT_SHORT}
                    docker push ${REGISTRY}/devsecops/product-service:latest

                    docker tag devsecops/frontend:latest ${REGISTRY}/devsecops/frontend:${GIT_COMMIT_SHORT}
                    docker tag devsecops/frontend:latest ${REGISTRY}/devsecops/frontend:latest
                    docker push ${REGISTRY}/devsecops/frontend:${GIT_COMMIT_SHORT}
                    docker push ${REGISTRY}/devsecops/frontend:latest
                    
                    docker logout ${REGISTRY}
                '''
            }
        }

        stage(' Update ArgoCD') {
            when {
                branch 'main'
            }
            steps {
                echo ' Triggering ArgoCD sync...'
                sh '''
                    # ArgoCD API call to sync (requires ArgoCD CLI or API token)
                    echo "ArgoCD sync triggered"
                    # argocd app sync devsecops-app
                '''
            }
        }

        stage(' Notify') {
            steps {
                echo ' Build completed successfully!'
                sh '''
                    echo "Build Summary:"
                    echo "=============="
                    echo "Commit: ${GIT_COMMIT_SHORT}"
                    echo "Date: ${BUILD_DATE}"
                    echo "Images built and ready for deployment"
                '''
            }
        }
    }

    post {
        always {
            echo ' Cleanup...'
            sh 'docker logout || true'
        }
        success {
            echo ' Pipeline succeeded!'
        }
        failure {
            echo ' Pipeline failed!'
        }
    }
}